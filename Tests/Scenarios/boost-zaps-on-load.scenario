# Boosts' zaps on every page load (13 Nov 2026, the owner's call: a zapped element came back on reload).
# The boost is on from the document's start (BoostScript, a start script in every page browser): the
# zapped banner is hidden before the page's own inline script can see it. A page that sets its own
# adoptedStyleSheets, and elements that come later, stay zapped (a MutationObserver); a zap the page's
# CSS can't parse doesn't undo the others; what no zap names still shows. Then the same after a reload,
# and nothing once Boosts are off.
budget rss=700 stalls50=10
seed boosts.json [{"id":"0E5B6E0A-5C3B-4F8D-9C55-4A7C5F2B9E12","host":"127.0.0.1","name":"Zaps","enabled":true,"hue":0,"strength":0,"invert":false,"contrast":50,"brightness":50,"saturation":50,"textScale":1,"textCase":"none","zapped":["#banner","div:nth-zap((","div.late","aside.sidebar-ad"],"css":"","js":""}]
cra://open?url=${ORIGIN}/zap.html
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1.5
cra://debug?cdp=Runtime.evaluate&params={"expression":"['parsing',window.bannerWhileParsing,'banner',getComputedStyle(document.getElementById('banner')).display,'late',window.lateAdded?getComputedStyle(document.querySelector('div.late')).display:'not-yet','ad',getComputedStyle(document.querySelector('aside.sidebar-ad')).display,'keep',getComputedStyle(document.getElementById('keep')).display].join('-')"}
expect-log Cra cdp Runtime.evaluate .*"value":"parsing-none-banner-none-late-none-ad-none-keep-block"
cra://debug?boostState=first
expect-log boost state first: .*adopted.*true.*zaps.*:4.*hidden.*:3
# Reload: the same from the start again.
cra://action/reload
wait 2
cra://debug?cdp=Runtime.evaluate&params={"expression":"['again',window.bannerWhileParsing,getComputedStyle(document.getElementById('banner')).display,window.lateAdded?getComputedStyle(document.querySelector('div.late')).display:'not-yet'].join('-')"}
expect-log Cra cdp Runtime.evaluate .*"value":"again-none-none-none"
# Boosts off (Settings ▸ Advanced): the page shows as it is, at once and after a reload, the start
# script gone with it.
pane://debug?settingsPane=profiles
wait 1.5
pane://debug?settingsPageJS=craSettings.set('boostsEnabled',false).then(s=>`boosts ${s.settings.boostsEnabled}`)
expect-log settings page js: boosts false
cra://action/closeTab
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"['off',getComputedStyle(document.getElementById('banner')).display,getComputedStyle(document.querySelector('div.late')).display].join('-')"}
expect-log Cra cdp Runtime.evaluate .*"value":"off-block-block"
cra://action/reload
wait 2
cra://debug?cdp=Runtime.evaluate&params={"expression":"['offAgain',window.bannerWhileParsing,getComputedStyle(document.getElementById('banner')).display].join('-')"}
expect-log Cra cdp Runtime.evaluate .*"value":"offAgain-block-block"
