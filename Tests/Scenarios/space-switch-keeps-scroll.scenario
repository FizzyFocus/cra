cra://debug?windowSize=1200x800
wait 1.5
# The 28th of 30 tabs open: the list brings it into view, near the bottom.
cra://debug?selectTab=E6000000-0000-0000-0000-000000000028
wait 1.5
cra://debug?listScroll=opened
expect-log list scroll opened: y=[1-9][0-9]* max=[1-9][0-9]* selectedShows=1
# Scrolled back to the top by hand: the open tab is below the list.
cra://debug?listScroll=top&to=0
expect-log list scroll top: y=0 .* selectedShows=0
# Away to the other space and back.
cra://action/space2
wait 1.5
cra://action/space1
wait 1.5
cra://debug?listScroll=back
expect-log list scroll back: y=0 .* selectedShows=0
# A tab picked in the space still comes into view.
cra://debug?selectTab=E6000000-0000-0000-0000-000000000026
wait 1.5
cra://debug?listScroll=picked
expect-log list scroll picked: y=[1-9][0-9]* .* selectedShows=1
