cra://open?url=${PAGE}?n=1
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
cra://open?url=${PAGE}?n=2
cra://open?url=${PAGE}?n=3
wait 2
# A collapsed section removed, then ⌘Z: back with its tabs, its behavior, collapsed; ⇧⌘Z removes it again.
cra://debug?newSection=Mine&tabs=2
wait 0.5
cra://debug?rowMenu=0&run=Collapse Section
wait 0.6
cra://debug?rowMenu=0&run=Remove Section
wait 0.6
cra://debug?todayRows=removed
expect-log today rows removed: n=3 \| n=2 \| n=1$
cra://debug?key=z,6,1048576
wait 0.8
expect-log sidebar undid Remove Section
cra://debug?tabGroups=undone
expect-log tab groups undone: Mine\(collapsed rows=[01]/2\)
cra://debug?sectionPolicies=undone
expect-log section policies undone: Mine=Add Only\[n=3,n=2\]$
cra://debug?key=Z,6,1179648
wait 0.8
expect-log sidebar redid Remove Section
cra://debug?todayRows=redone
expect-log today rows redone: n=3 \| n=2 \| n=1$

# Library ▸ Spaces: Set Profile ▸ Work from Notes' card, then ⌘Z and ⇧⌘Z there.
cra://action/manageSpaces
wait 1.5
cra://debug?libraryCardMenu=1&run=Work
wait 0.5
cra://debug?spaceOrder=profiled
expect-log space order profiled: Home\(Default\) Notes\(Work\) Work\(Default\)$
cra://debug?key=z,6,1048576
wait 0.8
expect-log sidebar undid Change Profile
cra://debug?spaceOrder=unprofiled
expect-log space order unprofiled: Home\(Default\) Notes\(Default\) Work\(Default\)$
cra://debug?key=Z,6,1179648
wait 0.8
expect-log sidebar redid Change Profile
# A card moved to the end, and back with ⌘Z.
cra://debug?libraryMoveCard=0&to=2
wait 0.8
cra://debug?spaceOrder=moved
expect-log space order moved: Notes\(Work\) Work\(Default\) Home\(Default\)$
cra://debug?key=z,6,1048576
wait 0.8
expect-log sidebar undid Move Space
cra://debug?spaceOrder=back
expect-log space order back: Home\(Default\) Notes\(Work\) Work\(Default\)$
reject-log sidebar (undo|redo) refused
reject-log would tear the sidebar
cra://debug?leaveLibrary=1
wait 1
cra://debug?checkStore=1
