# The command bar is dark in a dark space and follows macOS in a light one (12 Nov 2026,
# CraCore CommandBarTones.appearance): on a light Mac a dark space's ⌘T bar was a bright white card
# on its dark window, as an Incognito window's was (new-window-inherits checks that one). Arc's bar
# follows macOS whatever the space (#187); the fork keeps that for light spaces only.
# systemAppearance flips the app's appearance without touching the Mac's own setting.
budget rss=700 stalls50=20
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
seed sidebar.json {"version":1,"spaceOrder":["A0000000-0000-0000-0000-000000000001","A0000000-0000-0000-0000-000000000002"],"spaces":[{"id":"A0000000-0000-0000-0000-000000000001","title":"Light","emoji":"☀️","theme":{"colors":["#DCF3FC","#DCF3FC"],"intensity":0.5,"noise":0,"appearance":"light","accent":"#8389FF","solid":true,"key":["#DCF3FC"]},"favoritesContainerID":"C0000000-0000-0000-0000-000000000011","pinnedContainerID":"C0000000-0000-0000-0000-000000000012","todayContainerID":"C0000000-0000-0000-0000-000000000013","createdAt":"2026-11-06T08:00:00Z"},{"id":"A0000000-0000-0000-0000-000000000002","title":"Dark","emoji":"🌙","theme":{"colors":["#2B2734","#2B2734"],"intensity":1,"noise":0,"appearance":"dark","accent":"#8389FF","solid":true,"key":["#2B2734"]},"favoritesContainerID":"C0000000-0000-0000-0000-000000000021","pinnedContainerID":"C0000000-0000-0000-0000-000000000022","todayContainerID":"C0000000-0000-0000-0000-000000000023","createdAt":"2026-11-06T08:00:00Z"}],"items":[{"id":"C0000000-0000-0000-0000-000000000011","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000012","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000013","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000021","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000022","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000023","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}}]}
cra://debug?systemAppearance=light
cra://debug?windowSize=1200x800
wait 1
cra://commandbar
cra://debug?commandBarState=light-space
expect-log command bar light-space: open=1 .* dark=0
cra://debug?closeCommandBar=1
cra://action/space2
wait 1
cra://commandbar
cra://debug?commandBarState=dark-space
expect-log command bar dark-space: open=1 .* dark=1
cra://debug?closeCommandBar=1
# A light space's bar still follows macOS: dark on a dark Mac.
cra://action/space1
cra://debug?systemAppearance=dark
wait 1
cra://commandbar
cra://debug?commandBarState=light-space-dark-mac
expect-log command bar light-space-dark-mac: open=1 .* dark=1
cra://debug?closeCommandBar=1
cra://debug?systemAppearance=light
