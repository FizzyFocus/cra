# The Little Window's bar (13 Nov 2026, the owner's calls): in the colours of the space it opens into
# (light here; Arc draws it dark whatever the space), the address with the whole pill to itself (the
# profile's chip in it left a narrow window none), and the page's profile picked from the bar's
# right-click menu instead. A Little Window opens in the profile of the space it opens into.
# Personal is on Default, Random on the profile Hobbies (as in little-window-route).
budget rss=900 stalls50=40
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "defaultLinkDestination": {"littleWindow": {}}, "linkRoutes": [{"id": "E0000000-0000-0000-0000-000000000001", "match": "contains", "text": "n=random", "destination": {"littleWindow": {"space": "A0000000-0000-0000-0000-000000000002"}}}, {"id": "E0000000-0000-0000-0000-000000000002", "match": "contains", "text": "chrome://version", "destination": {"littleWindow": {"space": "A0000000-0000-0000-0000-000000000002"}}}, {"id": "E0000000-0000-0000-0000-000000000003", "match": "contains", "text": "n=gone", "destination": {"littleWindow": {"space": "A0000000-0000-0000-0000-000000000009"}}}]}
