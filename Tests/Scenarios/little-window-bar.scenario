isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000023","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}}]}

cra://debug?externalURL=${PAGE}?n=bar
wait 2
cra://debug?littleShown=opened
expect-log little shown opened: windows=1 space=Personal profile=Default
cra://debug?littleBar=wide
expect-log little bar wide: address=127\.0\.0\.1 shown=all look=light menu=Copy Link\|──\|Profile \[Default✓,Hobbies\]$
cra://debug?littleBar=narrow&width=520
expect-log little bar narrow: address=127\.0\.0\.1 shown=all look=light
# Profile ▸ Hobbies, asked first: the page loads again in Hobbies.
cra://debug?littleBar=pick&run=Hobbies
wait 0.5
cra://debug?answerDialog=Change Profile
wait 2
cra://debug?littleShown=picked
expect-log little shown picked: windows=1 space=Personal profile=Hobbies
cra://debug?littleBar=after
expect-log little bar after: .* menu=Copy Link\|──\|Profile \[Default,Hobbies✓\]$
