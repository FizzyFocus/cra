<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share inbox (MobileShareInbox) waits in the Keychain group the app also reads: no App
	     Groups on Pane's free Apple team (14 Nov 2026). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uz.pane.ios.shared</string>
	</array>
</dict>
</plist>
