<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pane is signed by a free Apple team (GWSB8L799B, 14 Nov 2026), which Apple gives no iCloud
	     containers or App Groups. The Mac's Spaces come from the sync folder the user picks in Files
	     (SyncedSidebar), and links from the share sheet wait in a Keychain access group the app and
	     its share extension both claim (MobileShareInbox, PaneKeychainGroup in Info.plist). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uz.pane.ios.shared</string>
	</array>
</dict>
</plist>
